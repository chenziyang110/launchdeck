  "acceptance_criteria": [
    {
      "id": "AC-001",
      "statement": "examples/sample-projects 与 gallery catalog 恰好包含十个已批准 ID、栈和主题；每个 ID 唯一映射到一个存在的源码目录。",
      "verification": "catalog schema 与精确 inventory 集合测试。"
    },
    {
      "id": "AC-002",
      "statement": "每个样例可脱离 Launchdeck 独立复制，包含独立 MIT 许可、锁文件、确定性种子、栈原生持久化、原生测试及可观察页面或 API；不含 .launchdeck.yml、Launchdeck 依赖、答案、评分或遥测。",
      "verification": "十目录静态纯度审计和隔离原生安装/测试/启动/健康检查。"
    },
    {
      "id": "AC-003",
      "statement": "每个样例的临时副本均可由外部验证夹具形成候选 .launchdeck.yml，经 doctor 验证后完成适用的 setup/build/test/start/health/stop，且源目录始终无 Launchdeck 产物。",
      "verification": "Windows/Linux 隔离 Launchdeck 端到端矩阵与 finally 清理。"
    },
    {
      "id": "AC-004",
      "statement": "example list 与 copy 在人类、--json、--compact、TTY 和非 TTY 模式遵循既有 CLI 合约；显式 ID 永不提示，省略 ID 仅可在交互 TTY 打开搜索选择。",
      "verification": "CLI 参数、输出 envelope、TTY 门控、取消和窄宽/no-color 测试。"
    },
    {
      "id": "AC-005",
      "statement": "copy 默认到 ./\u003cid\u003e，拒绝任何已存在目标或错误类型目标，在同一父目录 staging 后原子 rename；复制、rename 或取消失败后目标与 staging 均无残留。",
      "verification": "目标状态矩阵与故障注入回滚测试。"
    },
    {
      "id": "AC-006",
      "statement": "npm 实包包含完整 gallery，packed \u003c=5 MiB、unpacked \u003c=20 MiB；Windows/Linux 原生 CI 验证十个样例，仓库源、复制结果与 tarball 不一致时阻断发布。",
      "verification": "实际 npm pack inventory/尺寸/摘要和双平台必需矩阵。"
    },
    {
      "id": "AC-007",
      "statement": "catalog 是 list、copy、README 索引、tarball inventory 与验证矩阵的唯一元数据来源，字段仅为 ID/title/stack/theme/requirements/ports/source path。",
      "verification": "消费者均从 catalog 派生且无重复手写 inventory 的契约测试。"
    },
    {
      "id": "AC-008",
      "statement": "十个样例分别在声明的稳定或 LTS 工具链上使用锁定依赖通过原生测试，种子结果可重复，端口唯一且可覆盖，停止后无进程或运行文件残留。",
      "verification": "每栈原生 lifecycle matrix 与端口/清理断言。"
    },
    {
      "id": "AC-009",
      "statement": "兼容性夹具逐样例证明配置内容可审阅、任务与端口准确，并通过 Launchdeck setup/build/test/start/HTTP-or-API-health/stop；该证明不被描述为样例评分。",
      "verification": "逐样例 Launchdeck acceptance receipts，检查任务、健康和 owned-process cleanup。"
    },
    {
      "id": "AC-010",
      "statement": "example list 人类输出可扫描且窄宽/no-color 可读；JSON 与 compact 各输出一个 schemaVersion 1 对象，目录字段与 catalog 精确一致。",
      "verification": "人类快照、60/120 列、no-color 和 JSON 单对象测试。"
    },
    {
      "id": "AC-011",
      "statement": "example copy 覆盖显式 ID、未知 ID、TTY 搜索/无匹配/取消、非 TTY 缺失 ID、目标冲突、copy 失败、rename 失败和成功 receipt，均返回稳定且可操作的结果。",
      "verification": "完整状态-行为矩阵、稳定错误码和无残留断言。"
    },
    {
      "id": "AC-012",
      "statement": "发布门禁对实际 tarball 执行精确十项目快照、禁入项、5/20 MiB 阈值和 Windows/Linux 全矩阵；任何 skip、源码漂移或范围缩减均失败。",
      "verification": "package gate 与 CI contract tests。"
    }
  ],
